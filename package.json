{
  "name": "bundar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bundar — a Bun-native, HTML-first TypeScript framework with server-only JSX and official htmx.",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/*",
    "create-bundar",
    "examples/*",
    "templates/*"
  ],
  "scripts": {
    "agent-map:check": "bun tools/agent-map/check.ts",
    "api:check": "bun tools/api-check.ts",
    "api:report": "bun tools/api-report.ts",
    "app:arch": "bun tools/app-architecture/check.ts",
    "app:complexity:check": "bun tools/app-complexity/check.ts",
    "architecture:check": "bun tools/architecture-check/check.ts",
    "bench": "bun tools/benchmark/runner.ts",
    "bench:jsx-stream": "bun tools/benchmark/jsx-stream.ts",
    "bench:m1": "bun tools/benchmark/runner.ts --output artifacts/bench/m1.json",
    "bench:m2": "bun tools/benchmark/m2-jsx.ts",
    "bench:parity": "bun tools/benchmark/parity.ts",
    "bench:regression": "bun tools/benchmark/regression.ts",
    "bench:release": "bun tools/benchmark/release.ts",
    "bench:report": "bun tools/benchmark/report.ts",
    "bench:smoke": "bun tools/benchmark/smoke.ts",
    "build": "bun run --filter='./packages/*' --filter='./create-bundar' build",
    "ci:m0": "bun scripts/m0-gate.ts",
    "ci:m1": "bun scripts/m1-gate.ts",
    "ci:m2": "bun scripts/m2-gate.ts",
    "ci:m3": "bun scripts/m3-gate.ts",
    "ci:m4": "bun scripts/m4-gate.ts",
    "ci:release": "bun scripts/release-gate.ts",
    "clean": "bun run scripts/clean.ts",
    "conformance:release-report": "bun tools/e2e-release.ts",
    "conformance:report": "bun tests/browser/conformance-report.ts",
    "docs:check": "bun run scripts/docs-check.ts",
    "docs:claims-check": "bun tools/docs/claims-check.ts",
    "docs:generate": "bun tools/docs/generate-api.ts && bun tools/docs/generate-compat.ts",
    "docs:links": "bun tools/okf-validator/cli.ts links",
    "docs:snippets": "bun test tests/docs/snippets.test.ts",
    "docs:status-check": "bun tools/docs/readme-status.ts",
    "docs:validate": "bun tools/okf-validator/cli.ts validate",
    "docs:site:sync": "bun tools/website/sync-content.ts",
    "docs:site:check": "bun tools/website/check-site.ts",
    "docs:site:dev": "bun tools/website/sync-content.ts && cd website && bun run dev",
    "docs:site:build": "bun tools/website/sync-content.ts && cd website && bun run build",
    "docs:site:preview": "bun tools/website/sync-content.ts && cd website && bun run preview",
    "exports:check": "bun tools/release/publish-dry-run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "htmx:audit": "bun packages/cli/src/bin.ts htmx-audit",
    "htmx:source-diff": "bun tools/source-diff.ts",
    "issues:check": "bun tools/issues/validate.ts",
    "issues:graph": "bun tools/okf-validator/cli.ts graph",
    "licenses:check": "bun tools/pack-audit.ts",
    "links:artifacts": "bun tools/release/notes-check.ts",
    "lint": "eslint .",
    "pack:all": "bun tools/pack-audit.ts",
    "pack:audit": "bun tools/pack-audit.ts",
    "pack:inspect": "bun scripts/pack-inspect.ts",
    "package:audit": "bun tools/pack-audit.ts",
    "preflight": "bun run scripts/preflight.ts",
    "preinstall": "bun run scripts/preflight.ts",
    "publish:approved": "bun tools/release/publish-approved.ts",
    "publish:dry-run": "bun tools/release/publish-dry-run.ts",
    "release:notes-check": "bun tools/release/notes-check.ts",
    "release:plan": "bun tools/release/plan.ts",
    "release:provenance": "bun tools/release/provenance.ts",
    "release:reproduce": "bun tools/release/reproduce.ts",
    "release:sbom": "bun tools/release/sbom.ts",
    "release:verify": "bun tools/release/verify.ts",
    "release:candidate-identity": "bun tools/release/candidate-identity.ts",
    "registry:verify": "bun tools/release/registry-verify.ts",
    "routes:check": "bun packages/cli/src/bin.ts routes check --entry tests/consumer/routes/entry.ts --out tests/consumer/routes/routes.gen.ts",
    "routes:generate": "bun packages/cli/src/bin.ts routes generate --entry tests/consumer/routes/entry.ts --out tests/consumer/routes/routes.gen.ts",
    "secrets:scan": "bun tools/pack-audit.ts",
    "security:cache": "bun tools/security/cache-audit.ts",
    "security:cookies": "bun tools/security/cookies-audit.ts",
    "security:csrf": "bun tools/security/csrf-audit.ts",
    "security:example-admin": "bun test examples/admin-crud/src/security.test.ts",
    "security:headers": "bun tools/security/headers-audit.ts",
    "security:jsx": "bun tools/security/jsx-corpus.ts",
    "security:raw-html-audit": "bun tools/security/raw-html-audit.ts",
    "security:redirects": "bun tools/security/redirects-audit.ts",
    "security:report": "bun tools/security/security-report.ts",
    "security:response-hygiene": "bun tools/security/response-hygiene-audit.ts",
    "security:sinks": "bun tools/security/sink-audit.ts",
    "security:uploads": "bun tools/security/uploads-audit.ts",
    "security:validation-redaction": "bun tools/security/validation-redaction.ts",
    "snapshots:jsx": "bun tools/jsx-snapshots.ts",
    "test": "bun test",
    "test:a11y": "bun tests/browser/accessibility/run.ts",
    "test:browser:accessibility": "bun tests/browser/accessibility/run.ts",
    "test:browser:htmx2": "bun tests/browser/run.ts htmx2",
    "test:browser:htmx4": "bun tests/browser/run.ts htmx4",
    "test:browser:jsx": "bun tests/browser/jsx/run.ts",
    "test:browser:report": "bun tests/browser/report.ts",
    "test:consumer:core": "bun test ./tests/consumer/core",
    "test:consumer:jsx": "bunx tsc --noEmit -p tests/consumer/jsx/tsconfig.json",
    "test:consumer:routes": "bun test ./tests/consumer/routes",
    "test:consumer:schema": "bunx tsc --noEmit -p tests/consumer/schema/tsconfig.json && bun test ./tests/consumer/schema",
    "test:consumer:testing": "bun test ./tests/consumer/testing",
    "test:dev-loop": "bun test packages/cli/test/dev",
    "test:dual-app": "bun tests/browser/dual/run.ts",
    "test:dx-cleanroom": "bun tools/dx-cleanroom.ts",
    "test:e2e:release": "bun tools/e2e-release.ts",
    "test:example": "bun tools/test-example.ts",
    "test:fuzz": "bun test tests/fuzz",
    "test:fuzz:long": "BUNDAR_FUZZ_LONG=1 bun test tests/fuzz",
    "test:guides": "bun test tests/docs/guides.test.ts tests/docs/snippets-guide.test.ts",
    "test:integration:core": "bun test ./packages/core/test/integration ./packages/core/test/middleware ./packages/core/test/concurrency",
    "test:no-js": "bun tests/browser/no-js/run.ts",
    "test:pack-consumers": "bun tools/pack-consumers.ts",
    "test:property": "bun test tests/property",
    "test:reference-workflow": "bun test tests/workflow",
    "test:scaffold": "bun tools/test-scaffold.ts",
    "test:security": "bun tools/security/test-matrix.ts",
    "test:template": "bun tools/test-template.ts",
    "test:types": "bun scripts/test-types.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:perf": "bun scripts/typecheck-perf.ts",
    "bench:beta": "bun tools/benchmark/beta-workloads.ts"
  },
  "devDependencies": {
    "@carno.js/core": "1.7.0",
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.18",
    "@types/bun": "1.3.14",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "hono": "4.13.3",
    "playwright": "1.63.0-alpha-2026-08-05",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "valibot": "1.4.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
