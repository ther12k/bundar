      "allowedBundarPackages": [],
      "allowedExternalImports": []
    },
    "@bundar/forms": {
      "path": "packages/forms",
      "allowedBundarPackages": ["@bundar/core", "@bundar/schema"],
      "allowedExternalImports": []
    },
    "@bundar/security": {
      "path": "packages/security",
      "allowedBundarPackages": ["@bundar/core"],
      "allowedExternalImports": []
    },
    "@bundar/testing": {
      "path": "packages/testing",
