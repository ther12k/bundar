{
  "name": "create-bundar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scaffolding tool for new Bundar applications.",
  "main": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/bin.ts --outdir ./dist --target=bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "license": "MIT",
  "bin": {
    "create-bundar": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "templates",
    "README.md"
  ]
}
