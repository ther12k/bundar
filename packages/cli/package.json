{
  "name": "@bundar/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bundar command-line tooling: dev server, route manifests, and the HTMX migration audit.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "bundar": "./src/bin.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/bin.ts --outdir ./dist --target=bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@bundar/core": "workspace:*"
  }
}
