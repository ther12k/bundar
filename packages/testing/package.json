{
  "name": "@bundar/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bundar in-process test client and request helpers.",
  "main": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target=bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "license": "MIT",
  "dependencies": {
    "@bundar/core": "workspace:*",
    "@bundar/htmx": "workspace:*",
    "@bundar/jsx": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ther12k/bundar.git",
    "directory": "packages/testing"
  }
}
