{
  "name": "@bundar/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bundar HTTP core: typed route registration compiled to Bun.serve native route tables.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target=bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  }
}
